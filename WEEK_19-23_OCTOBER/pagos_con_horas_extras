Algoritmo pago_con_horas_extra
	definir num,horas,extra Como Real
	escribir "cuantas horas trabajo: "
	leer horas
	extra <- horas
	Si horas > 42 Entonces
		extra <- (42*8838)+((horas -42) *8838*1.5)
		escribir " el pago total con horas extras es:  ",extra
	SiNo
		escribir "pago total:  ",horas*8838
	Fin Si
FinAlgoritmo
